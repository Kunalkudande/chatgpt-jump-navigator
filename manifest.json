{
  "manifest_version": 3,
  "name": "ChatGPT Navigation Dropdown",
  "version": "2.0.0",
  "description": "Quick navigation dropdown for long ChatGPT conversations. Jump to any of your messages instantly.",
  "permissions": [],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
