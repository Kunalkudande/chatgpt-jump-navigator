{
  "manifest_version": 3,
  "name": "ChatGPT Jump Navigator - Search & Bookmarks",
  "short_name": "ChatGPT Jump Navigator",
  "version": "3.2.0",
  "description": "Search messages in long ChatGPT conversations, bookmark prompts, and jump to earlier messages as chat history loads.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "author": "Kunalkudande",
  "homepage_url": "https://github.com/Kunalkudande/chatgpt-jump-navigator"
}
